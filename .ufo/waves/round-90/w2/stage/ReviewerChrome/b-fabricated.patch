-            <td class="right">20</td>
-        </tr>
-        <tr>
-            
-            <td><img height="20" src="data:image/svg+xml;base64," width="20"/></td>
-            <td>The language has both a maximal and a minimal system</td>
-            <td class="right">21</td>
-        </tr>
