-<p class="Standard">no pronoun + stem</p>
-</td>
-</tr>
-<tr>
-<td style="text-align:left;">
-<p class="Standard">b.</p>
-</td>
-<td style="text-align:left;">
-<p class="Standard"><span class="T3"><span class="hint--bottom" data-hint="imperative">imp</span>.<span class="hint--bottom" data-hint="plural">2pl:</span></span></p>
-</td>
-<td style="text-align:left;">
-<p class="Standard">special pronoun + stem</p>
-</td>
-</tr>
-<tr>
-<td style="text-align:left;">
-<p class="Standard">c.</p>
-</td>
-<td style="text-align:left;">
-<p class="Standard"><span class="T3"><span class="hint--bottom" data-hint="hortative">hort</span>.<span class="hint--bottom" data-hint="plural">1pl:</span></span></p>
-</td>
