-<p class="Standard"><i>mnas, </i></p>
-</td>
-<td style="text-align:left;">
-<p class="Standard"><i>aɣĵik-s. </i></p>
-</td>
-</tr>
-<tr>
-<td style="text-align:left;">
-<p class="Standard">you </p>
-</td>
-<td style="text-align:left;">
-<p class="Standard">well </p>
-</td>
-<td style="text-align:left;">
-<p class="Standard">remain.<span class="T3">subj.<span class="hint--bottom" data-hint="future">fut</span>.<span class="hint--bottom" data-hint="singular">2sg</span></span></p>
-</td>
-<td style="text-align:left;">
-<p class="Standard">daughter-<span class="T3"><span class="hint--bottom" data-hint="possessive">poss</span></span></p>
-</td>
