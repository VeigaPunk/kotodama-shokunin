rev=$1; lesson=$2; hdr=$(git show "$rev:$lesson" | grep -c '^Rejections'); out=$(git show "$rev:$lesson" | grep -E '^\|.*\|[[:space:]]*([Rr]efused|[Rr]ejected)[^|]*\|[[:space:]]*$' | while IFS= read -r row; do art=$(printf '%s\n' "$row" | grep -oE '(reports|corpus|\.ufo)/[A-Za-z0-9._/-]+\.(txt|md|json|html)' | head -1); span=$(printf '%s\n' "$row" | grep -oE '(「[^」]{2,}」|«[^»]{2,}»)' | head -1); if [ -z "$art" ] || [ -z "$span" ]; then echo "NO-FIELD ${row:0:48}"; continue; fi; body=$(printf '%s' "$span" | sed 's/^.//;s/.$//'); c=$(git show "$rev:$art" 2>/dev/null | grep -c -F -- "$body"); if printf '%s' "$row" | grep -qi absent; then [ "${c:-0}" -eq 0 ] && echo "OK $art count=0" || echo "MISFILED $art count=$c (reason asserts absence)"; elif printf '%s' "$row" | grep -qi present; then [ "${c:-0}" -ge 1 ] && echo "OK $art count=$c" || echo "MISFILED $art count=0 (reason asserts presence)"; else echo "REVIEW $art count=${c:-0} (finding not stated)"; fi; done); em=""; { [ "$hdr" -eq 0 ] || [ -n "$out" ]; } || em="EMPTY-SELECTOR heading=Rejections selected=0"; printf '%s\n' "$out"; [ -z "$em" ] || printf '%s\n' "$em"; ! printf '%s\n%s\n' "$out" "$em" | grep -qE '^(NO-FIELD|MISFILED|EMPTY-SELECTOR)'
