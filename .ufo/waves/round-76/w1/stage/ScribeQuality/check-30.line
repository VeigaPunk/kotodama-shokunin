rev=$1; reg=$2; rcdir=$3; regtxt=$(git show "$rev:$reg"); out=$(for f in $(git ls-tree --name-only "$rev" "$rcdir/" | grep -E 'S[0-9]{3}\.txt$'); do id=${f##*/}; id=${id%.txt}; rbody=$(git show "$rev:$f"); q=$(printf '%s\n' "$rbody" | grep -m1 '^quote:' | sed 's/^quote:[[:space:]]*//'); cell=$(printf '%s\n' "$regtxt" | grep -m1 "^| *$id " | cut -d'|' -f7 | sed 's/^ *//; s/ *$//'); span=$(printf '%s\n' "$cell" | sed -n 's/.*quote located:[[:space:]]*//p' | sed -n 's/^[«「]\(.*\)[»」]$/\1/p'); case "$cell" in *"$q"*) ins=no;; *) ins=yes;; esac; win=$(printf '%s\n' "$rbody" | sed -n '/^--- window ---$/,$p' | tail -n +2 | head -1); [ -z "$span" ] && { printf '%s NO-ANCHOR-SPAN (criterion 18)\n' "$id"; continue; }; hits=$(printf '%s\n' "$win" | grep -c -F -- "$span"); printf '%s MISBOUND=%s OUTSIDE_WINDOW=%s\n' "$id" "$ins" "$([ "${hits:-0}" -eq 0 ] && echo yes || echo no)"; done); printf '%s\n' "$out"; ! printf '%s\n' "$out" | grep -qE 'MISBOUND=yes|OUTSIDE_WINDOW=yes'
