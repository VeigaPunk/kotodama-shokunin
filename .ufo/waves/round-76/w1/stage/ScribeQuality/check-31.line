rev=$1; reg=$2; evdir=$3; regtxt=$(git show "$rev:$reg"); ids=$(git ls-tree --name-only "$rev" "$evdir/" | sed 's#.*/##; s#\.txt$##' | sort); out=$(i=0; for id in $ids; do i=$((i+1)); cell=$(printf '%s\n' "$regtxt" | grep -m1 "^| *$id " | cut -d'|' -f7 | sed 's/^ *//; s/ *$//'); span=$(printf '%s\n' "$cell" | sed -n 's/.*quote located:[[:space:]]*//p' | sed -n 's/^[«「]\(.*\)[»」]$/\1/p'); [ -z "$span" ] && { printf '%s NO-SPAN\n' "$id"; continue; }; own=$(git show "$rev:$evdir/$id.txt" | grep -c -F -- "$span"); [ "${own:-0}" -gt 0 ] && { printf '%s OK own=%s\n' "$id" "$own"; continue; }; j=0; verdict=ABSENT; for other in $ids; do j=$((j+1)); [ "$other" = "$id" ] && continue; c=$(git show "$rev:$evdir/$other.txt" | grep -c -F -- "$span"); [ "${c:-0}" -eq 0 ] && continue; d=$((j-i)); [ "$d" -lt 0 ] && d=$((-d)); [ "$d" -eq 1 ] && verdict="ADJACENT -> $other (own=0 hits=$c)" || verdict="FOREIGN $other (own=0 hits=$c)"; break; done; printf '%s %s\n' "$id" "$verdict"; done); printf '%s\n' "$out"; ! printf '%s\n' "$out" | grep -qE '(ADJACENT|FOREIGN)'
