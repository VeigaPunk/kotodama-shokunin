AUI().use(
	"node-scroll-info",
	"transition",
    function(A) {
		var body = A.one("body");
        var btt = A.one("#back-to-top");
        
        btt.hide();
        var hidden = true;
        
        if (!("scrollInfo" in body)) {
            body.plug(A.Plugin.ScrollInfo);
        }
        
		body.scrollInfo.on("scroll", function(e) {
        	if (hidden && window.pageYOffset >= 500) {
        		hidden = false;
        		btt.show();
        		btt.transition({
        			opacity: 0.9
        		});
        	}
            if (!hidden && window.pageYOffset < 500) {
                hidden = true;
                btt.transition({
                    opacity: 0
                }, function() {
                    btt.hide();
                });
            }
        });
	    
	    window.onpageshow = function() {
	    	if (window.pageYOffset >= 500) {
        		hidden = false;
        		btt.show();
        		btt.transition({
        			opacity: 0.9
        		});
        	}
	    };
    }
);
</script> <script type="text/javascript">
