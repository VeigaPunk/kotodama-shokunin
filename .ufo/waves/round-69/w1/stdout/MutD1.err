  W = "/tmp/mutd1"

  orig = open(ORIG, encoding="utf-8").read()

  STATES5 = 'STATES = ("pending", "settled-active", "settled-retired", "settled-closed",\n          "settled-split")'
  STATES4 = 'STATES = ("pending", "settled-active", "settled-retired", "settled-closed")'
  assert STATES5 in orig, "STATES tuple not found verbatim"
  mut1 = orig.replace(STATES5, STATES4, 1)
  assert mut1 != orig
  TABLE5 = "and len(rows) == 5,"
  TABLE4 = "and len(rows) == len(STATES),"
  assert TABLE5 in orig
  mut2 = mut1.replace(TABLE5, TABLE4, 1)
  assert mut2 != mut1

  def w(p, s):
      with open(p, "w", encoding="utf-8") as fh: fh.write(s)
      os.chmod(p, 0o755)

  w(os.path.join(W, "accept-d-orig.py"), orig)
  w(os.path.join(W, "accept-d-mut1-states-only.py"), mut1)
  w(os.path.join(W, "accept-d-mut2-states-and-table.py"), mut2)

  TABLE = """### Registry correction chains

  | State | Row shape | Writer's next action | Error signature | Evidence |
  |---|---|---|---|---|
  | pending | successor mined, target mined | decide the ruling | chain-left-pending | S859 — tools/check-supersession-settlement.py:112 |
  | settled-active | successor mined, target queued | repoint the entry | entry-not-repointed | S859 — tools/check-supersession-settlement.py:127 |
  | settled-retired | successor rejected | keep the target | retired-row-mined | S859 — tools/check-supersession-settlement.py:129 |
  | settled-closed | target rejected | keep the successor | closed-chain-kept | S859 — tools/check-supersession-settlement.py:123 |
  """
  SPLIT_ROW = "| settled-split | both mined, scoped teaches | narrow the scope | scope-limiter-missing | S859 — tools/check-supersession-settlement.py:130 |\n"

  SIGS4 = """| Observation | Reading |
  |---|---|
  | chain-left-pending | the correction never landed; rule the chain |
  | entry-not-repointed | the successor is mined but no entry cites it |
  | retired-row-mined | a retired correction still reads as mined |
  | closed-chain-kept | the closed chain's successor was dropped |
  """
  SIGS5 = SIGS4 + "| scope-limiter-missing | both rows are mined without a scope limiter |\n"

  SOURCES = """# fixture SOURCES (mutation-test scratch)

  | S859 | fixture source — https://example.invalid/x | own-work | A | fixture | §1 | the fixture teaches | mined | 2026-10-24 | 90d | SKILL.md |
  """

  def build(root, counter_bytes, table, sigs):
      if os.path.exists(root): shutil.rmtree(root)
      os.makedirs(os.path.join(root, "corpus", "knowledge"))
      os.makedirs(os.path.join(root, "tools"))
      os.makedirs(os.path.join(root, "reports", "round-69"))
      skill = table + "\n## Error patterns\n\n" + sigs
      with open(os.path.join(root, "SKILL.md"), "w", encoding="utf-8") as fh: fh.write("# fixture skill\n\n" + skill)
      with open(os.path.join(root, "corpus", "SOURCES.md"), "w", encoding="utf-8") as fh: fh.write(SOURCES)
      with open(os.path.join(root, "corpus", "knowledge", "a.md"), "w", encoding="utf-8") as fh: fh.write("fixture\n")
      shutil.copy(os.path.join(LANE, "tools", "check-supersession-settlement.py"), os.path.join(root, "tools"))
      with open(os.path.join(root, "reports", "round-69", "accept-d.py"), "wb") as fh: fh.write(counter_bytes)

  def run(label, script, root):
      cmd = ["python3", "-B", script, "--root", root]
      print("\n$ " + label)
      print("$ " + " ".join(cmd))
      p = subprocess.run(cmd, capture_output=True, text=True)
      print(p.stdout.rstrip())
      if p.stderr.strip(): print("STDERR: " + p.stderr.rstrip())
      print("exit=%d" % p.returncode)
      return p

  b_orig, b_m1, b_m2 = orig.encode(), mut1.encode(), mut2.encode()
