  ```python
  import importlib.util, os, re, tempfile

  def load(name, path):
      spec = importlib.util.spec_from_file_location(name, path)
      m = importlib.util.module_from_spec(spec)
      spec.loader.exec_module(m)
      return m

  LANE = "/home/vgpnk/Projects/shokunin/kotodama-shokunin"
  orig = load("orig69", os.path.join(LANE, "reports", "round-69", "accept-ca.py"))
  mut  = load("mut69", "/tmp/r69-revo4/accept-ca-anyrow.py")

  with tempfile.TemporaryDirectory(prefix="ca69-false-accept-") as td:
      for label, mod in (("ORIGINAL", orig), ("WHITELIST-DROPPED", mut)):
          fx = os.path.join(td, label.lower().replace("-", ""))
          mod.build_fixture_root(fx, with_corrections=True)

          # guarantee a LIVE legcount mismatch inside the exact scanned surfaces
          claims = mod.load_claims(fx)
          obs = mod.observed_o_legs(fx) or (8, 9)
          p, q = obs[0] + 1, obs[1] + 1
          bad = "R68 operability claim: %d/%d legs PASS (rev04 attack injection)" % (p, q)
          for pair in claims.get("calibration_pairs", []):
              if pair["class"].upper() != "LEGCOUNT" or pair.get("fleet"):
                  continue
              path = os.path.join(fx, pair.get("path", ""))
              text = open(path, encoding="utf-8").read()
              sec = pair.get("section")
              lines = text.splitlines(True)
              out, done = [], False
              for line in lines:
                  out.append(line)
                  if sec and not done and re.match(sec, line):
                      out.append(bad + "\n")
                      done = True
              text = "".join(out)
              if not sec:
                  text += "\n" + bad + "\n"
              open(path, "w", encoding="utf-8").write(text)

          # corrections file: rows name the WRONG class for every surface
          claims = mod.load_claims(fx)
          rows = ["| class | surface | filed text | observed text | re-derivation command |",
                  "|---|---|---|---|---|"]
          for pair in claims.get("calibration_pairs", []):
              rows.append("| DEADPOINTER | %s | filed | observed | command |" % pair["surface"])
          with open(os.path.join(fx, mod.CORRECTIONS), "w", encoding="utf-8") as fh:
              fh.write("\n".join(rows) + "\n")

          fleet = os.path.join(fx, "fleet")
          claims = mod.load_claims(fx)
          res = mod.Result(quiet=True)
          mod.evaluate(fx, fleet, claims, res)
          print("== %s counter vs wrong-class correction rows ==" % label)
          for name, ok, detail in res.legs:
              print("LEG %s %s %s" % ("PASS" if ok else "FAIL", name, detail))
          print("ACCEPT-CA: %s" % ("PASS" if res.ok else "FAIL"))
          print()
  ```

