  Let me write the driver to do exactly that:

  ```python
  def inject_live_legcount(mod, fx):
      claims = mod.load_claims(fx)
      obs = mod.observed_o_legs(fx) or (11, 12)
      p, q = (obs[0] + 1, obs[1] + 1)
      bad = "R68 operability claim: %d/%d legs PASS (attack injection)" % (p, q)
      for pair in claims.get("calibration_pairs", []):
          if pair["class"].upper() != "LEGCOUNT":
              continue
          rel = pair.get("path", "")
          if pair.get("fleet"):
              continue
          path = os.path.join(fx, rel)
          text = open(path, encoding="utf-8").read()
          sec = pair.get("section")
          if sec:
              # insert right after the matching heading line
              lines = text.splitlines(True)
              out = []
              done = False
              for line in lines:
                  out.append(line)
                  if not done and re.match(sec, line):
                      out.append(bad + "\n")
                      done = True
              text = "".join(out)
          else:
              text = text + "\n" + bad + "\n"
          open(path, "w", encoding="utf-8").write(text)
  ```

