  2. Attack driver script /tmp/ca69-attack/attack.py:

  ```python
  #!/usr/bin/env python3
  """RevO5 attack: DEADPOINTER detector of reports/round-69/accept-ca.py.

  All mutation happens on COPIES under /tmp/ca69-attack. The lane tree is
  never written.
  """
  import importlib.util, json, os, shutil, subprocess, sys

  LANE = "/home/vgpnk/Projects/shokunin/kotodama-shokunin"
  SCRIPT = os.path.join(LANE, "reports/round-69/accept-ca.py")
  BASE = "/tmp/ca69-attack"

  spec = importlib.util.spec_from_file_location("accept_ca", SCRIPT)
  m = importlib.util.module_from_spec(spec)
  spec.loader.exec_module(m)

  def build(tag, with_corrections=False):
      fx = os.path.join(BASE, tag)
      if os.path.exists(fx):
          shutil.rmtree(fx)
      fleet = m.build_fixture_root(fx, with_corrections=with_corrections)
      return fx, fleet

  def run_counter(fx, fleet):
      p = subprocess.run([sys.executable, "-B", SCRIPT, "--root", fx,
                          "--fleet-root", fleet],
                         capture_output=True, text=True)
      return p.returncode, p.stdout.strip()

  def deadpointer_state(fx):
      # mirror of the detector internals, called through the module itself
      claims = m.load_claims(fx)
      pair = [p for p in claims["calibration_pairs"] if p["class"] == "DEADPOINTER"][0]
      text, key = m.surface_text(fx, pair, os.path.join(fx, "fleet"))
      hits = m.detect_deadpointer(text, fx)
      ids = [x.group(1) for x in m.MISTAKE_RE.finditer(text)]
      ids += [x.group(1) for x in m.PLUS_M_RE.finditer(text)]
      return key, sorted(set(ids)), hits

  def backfill(fx, row):
      lesson = os.path.join(fx, "corpus", "lessons", "round-68.md")
      with open(lesson, "a", encoding="utf-8") as fh:
          fh.write("\n" + row + "\n")
  ```

