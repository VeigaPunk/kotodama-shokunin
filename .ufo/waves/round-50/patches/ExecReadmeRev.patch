+            ["git", "-C", str(root), "-c", "user.name=selftest",
+             "-c", "user.email=selftest@invalid", "-c", "commit.gpgsign=false",
+             *args],
+            capture_output=True,
+            env=_git_env(),
+            timeout=30,
+            check=True,
+        )
