+    git("init", "-q")
+    shas = []
+    for text in readmes:
+        os.makedirs(os.path.join(root, "corpus"), exist_ok=True)
+        readme = os.path.join(root, "corpus", "README.md")
+        with open(readme, "w", encoding="utf-8") as fh:
+            fh.write(text)
+        git("add", "corpus/README.md")
+        git("commit", "-q", "-m", "fixture")
