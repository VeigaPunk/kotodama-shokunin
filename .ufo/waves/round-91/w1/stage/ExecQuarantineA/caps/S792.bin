function findPassword(email){
	var emailReg = /^([a-zA-Z0-9_-])+@([a-zA-Z0-9_-])+(.[a-zA-Z0-9_-])+/
	var email = document.getElementById(email).value;
	var matchemail = emailReg.test(email);
	var pars = "email="+email;
	if(email == '' || email == null){
		alert("Email不能为空！");
		return false;
	} else {
		if(matchemail){
			jQuery.post("https://journal.psych.ac.cn/xlkxjz/EN/user/findPassword.do?" + new Date(), pars, function(data){
				subwin.close();
			});
		}else{
			alert("Email格式不正确");		
		}
	}
}
