-def audit(root):
-    root = Path(root).resolve()
-    if not root.is_dir():
-        raise InputError('root is not a directory: ' + str(root))
-    knowledge = root / 'corpus/knowledge'
-    if not knowledge.is_dir():
-        raise InputError('missing corpus/knowledge under root')
-    readme = root / 'corpus/README.md'
-    text = readme.read_text(encoding='utf-8')
-    sections, supplemental, repeated_sections = parse_readme(text)
-    findings = []
-
-    def finding(category, location, **details):
-        findings.append(dict(id=category + ':' + location, **{'class': category},
-                             location=location, **details))
-
-    files = {}
-    for part in PARTS:
-        directory = knowledge / part
-        if not directory.is_dir():
-            finding('PARTITION_DIR_MISSING', part)
-            files[part] = []
-        else:
-            files[part] = sorted(p.name for p in directory.iterdir()
-                                 if p.suffix == '.md' and p.is_file())
-        if part not in sections:
-            finding('PARTITION_MISSING', part)
-    for part in sorted(set(sections) - set(PARTS)):
-        finding('PARTITION_UNKNOWN', part)
-    for part in sorted(set(repeated_sections)):
-        finding('DUPLICATE_SECTION', part)
-    rows = {p: list(sections.get(p, {}).get('rows', [])) for p in PARTS}
-    ownership = []
-    for filename, topic in supplemental:
-        owners = [p for p in PARTS if filename in files[p]]
-        ownership.append(dict(filename=filename, owners=owners))
-        if len(owners) == 1:
-            rows[owners[0]].append((filename, topic))
-        else:
-            finding('GHOST_ROW', 'unassigned/' + filename,
-                    kind='supplemental-unassigned', owners=owners, topic=topic)
-    parts = {}
-    for part in PARTS:
-        disk = set(files[part])
-        counts = Counter(f for f, _ in rows[part])
-        for filename, count in sorted(counts.items()):
-            if count > 1:
-                finding('DUPLICATE_ROW', part + '/' + filename, occurrences=count)
-        for filename in sorted(disk - counts.keys()):
-            finding('MISSING_ROW', part + '/' + filename)
-        for filename in sorted(counts.keys() - disk):
-            finding('GHOST_ROW', part + '/' + filename)
-        # Read each entry once even when a duplicate row names it repeatedly.
-        topics = {}
-        for filename in sorted(disk & counts.keys()):
-            body = (knowledge / part / filename).read_text(encoding='utf-8')
-            match = TOPIC_RE.search(body)
-            topics[filename] = (' '.join(line.strip() for line in
-                                match.group(1).strip('\n').splitlines()
-                                if line.strip()) if match else None)
-        for filename, topic in dict.fromkeys(rows[part]):
-            if filename not in topics:
-                continue
-            actual = topics[filename]
-            if actual != topic:
-                finding('TOPIC_MISMATCH', part + '/' + filename,
-                        kind='NO_TOPIC_FIELD' if actual is None else 'REWRITE',
-                        row_topic=topic, file_topic=actual)
-        declared = sections.get(part, {}).get('declared')
-        if declared is not None and declared != len(disk):
-            finding('HEADER_DRIFT', part, declared=declared, actual=len(disk))
-        parts[part] = dict(declared=declared, files=len(disk), rows=len(rows[part]),
-                           duplicate_rows=sorted(f for f, n in counts.items() if n > 1))
-    total = sum(len(files[p]) for p in PARTS)
-    totals = list(TOTALS_RE.finditer(text))
-    totals_line = int(totals[-1].group(1)) if totals else None
-    if totals_line is None:
-        finding('TOTALS_ABSENT', 'totals')
-    elif totals_line != total:
-        finding('TOTALS_DRIFT', 'totals', declared=totals_line, actual=total)
-    headers = list(FOOTER_HEADER_RE.finditer(text))
-    footer = None
-    live_vector = [len(files[p]) for p in PARTS]
-    if not headers:
-        finding('FOOTER_ABSENT', 'footer')
-    else:
-        header = headers[-1]
-        match = FOOTER_RE.match(text, header.start())
-        if match is None:
-            finding('FOOTER_MALFORMED', 'footer', date=header.group(1),
-                    line=text.count('\n', 0, header.start()) + 1)
-        else:
-            footer = dict(date=match.group(1), command=match.group(2),
-                          total=int(match.group(3)),
-                          dir_totals=[int(n) for n in match.group(4).split('/')],
-                          line=text.count('\n', 0, header.start()) + 1)
-            if footer['total'] != total:
-                finding('FOOTER_TOTAL', 'footer', declared=footer['total'], actual=total)
-            if footer['dir_totals'] != live_vector:
-                finding('FOOTER_DIR_TOTALS', 'footer', declared=footer['dir_totals'],
-                        actual=live_vector, order=list(PARTS))
-    findings.sort(key=lambda item: (item['id'], json.dumps(item, sort_keys=True)))
-    summary = ('CORPUS-INDEX: ' + ('FINDINGS' if findings else 'OK')
-               + f' files={total} rows={sum(len(r) for r in rows.values())}'
-               + f' findings={len(findings)}'
-               + (' ids=' + ','.join(sorted({f['class'] for f in findings}))
-                  if findings else ''))
-    return dict(ok=not findings, summary=summary, root=str(root),
-                readme_sha256=hashlib.sha256(text.encode('utf-8')).hexdigest(),
-                parts=parts, total_files=total, total_rows=sum(map(len, rows.values())),
-                totals_line=totals_line, footer=footer, footer_blocks=len(headers),
-                footer_live=dict(total=total, dir_totals=live_vector, order=list(PARTS)),
-                supplemental_ownership=ownership, findings=findings)
