-def parse_readme(text):
-    """R28 section spans, plus rows outside partition spans."""
-    headings = [m.start() for m in re.finditer(r'^## ', text, re.M)]
-    sections, spans = {}, []
-    duplicates = []
-    for match in SECTION_RE.finditer(text):
-        pos, part = match.start(), match.group(1)
-        end = next((h for h in headings if h > pos), len(text))
-        if part in sections:
-            duplicates.append(part)
-        rows = [(m.group(1), m.group(2)) for m in ROW_RE.finditer(text[pos:end])]
-        sections[part] = {'declared': int(match.group(2)), 'rows': rows}
-        spans.append((pos, end))
-    supplemental = [(m.group(1), m.group(2)) for m in ROW_RE.finditer(text)
-                    if not any(start <= m.start() < end for start, end in spans)]
-    return sections, supplemental, duplicates
