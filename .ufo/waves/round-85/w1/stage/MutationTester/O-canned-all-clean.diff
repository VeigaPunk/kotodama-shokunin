-PARTS = ('linguistics', 'myth-symbol', 'culture-material', 'synthesis',
-         'verification', 'civilizations')
-# R28 parser expressions and section/supplemental ownership semantics.
-SECTION_RE = re.compile(r'^## ([a-z-]+)/ \((\d+)\)\s*$', re.M)
-ROW_RE = re.compile(r'^- `([^`]+\.md)` — (.*)$', re.M)
-TOPIC_RE = re.compile(r'^- topic:(.*?)(?=\n- \w)', re.M | re.S)
-TOTALS_RE = re.compile(r'^Total knowledge entries: (\d+)\.\s*$', re.M)
-FOOTER_HEADER_RE = re.compile(r'^Counts checked (\d{4}-\d{2}-\d{2})\b[^\n]*', re.M)
-FOOTER_RE = re.compile(
-    r'^Counts checked (\d{4}-\d{2}-\d{2}) from the repo root:[ \t]*\n?[ \t]*'
-    r'`([^`]+)`[ \t]*\n?[ \t]*'
-    r'\(total (\d+) files; directory totals (\d+(?:/\d+)*)\)', re.M)
-
-
-class InputError(Exception):
-    """An unusable input or invocation, not a corpus finding."""
-
-
-class Parser(argparse.ArgumentParser):
-    def error(self, message):
-        raise InputError(message)
