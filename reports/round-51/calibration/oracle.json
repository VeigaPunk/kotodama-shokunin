{
  "schema": "kotodama-r51-reference-oracle-v1",
  "base": "bff83ba65bf9559af4d7567e81703059667a0005",
  "expectation_status": "Proposed expectations derived from reference identity and the pinned CLI/error contract, not measured output. Must be frozen by Main before execution/candidate implementation.",
  "grammar": "Complete slash-bearing local-reference tokens, including inline-code and Markdown-link destinations, repository-root form or lexically relative to the citing file directory. Strip a numeric :line locator or #fragment only after identifying the complete token. Explicit ./ and contained ../ segments normalize lexically. No filesystem traversal or link fetching. Any supported local reference that lexically crosses the repository root MUST return input error / exit2 with stable REFERENCE_OUTSIDE_REPOSITORY and the citing location. Multiple eligible canonical interpretations MUST return input error / exit2 with stable REFERENCE_AMBIGUOUS and the citing location. Neither becomes a clean zero; no host path is followed or fetched.",
  "limits": [
    "arbitrary bare-basename resolution",
    "semantic dependency inference",
    "unowned-path detection",
    "acceptance-write policing",
    "new export-regex semantics",
    "retroactively accepting original R50 claims.json"
  ],
