ren\":\"More Artwork\"}]}]}],null]}],[\"$\",\"p\",null,{\"className\":\"component-header-module-scss-module__DRFWnW__description\",\"children\":[\"$\",\"$L36\",null,{\"children\":null}]}]]}],[\"$\",\"$L34\",null,{\"hasDivider\":false,\"tabBodyWrapperClass\":\"related-artwork-module-scss-module__dawfoq__tabWrapper\",\"screenreaderLegendText\":\"More Artwork\",\"inputGroupName\":\"related-artworks\",\"tabs\":[{\"name\":\"Related\",\"body\":[\"$\",\"$L37\",null,{\"children\":[[\"$\",\"$L38\",\"collectionObject-473068\",{\"index\":0,\"enforceMaxWidth\":true,\"object\":{\"accessionNumber\":\"08.202.27a, b\",\"culture\":\"\",\"date\":\"500–700\",\"image\":\"https://collectionapi.metmuseum.org/api/collection/v1/iiif/473068/preview\",\"medium\":\"Rock crystal, silver mount\",\"objectID\":473068,\"primaryArtist\":\"\",\"title\":\"Necklace and Pendant Cross\",\"url\":\"https://www.metmuseum.org/art/collection/search/473068\"}}]]}]},{\"name\":\"In the same gallery\",\"body\":[\"$\",\"$L37\",null,{\"children\":[[\"$\",\"$L38\",\"collectionObject-undefined\",{\"index\":0,\"enforceMaxWidth\":true,\"object\":{\"accessionNumber\":\"1995.267.2\",\"artistPrimary\":\"Sherrie Levine\",\"artistSecondary\":[],\"artists\":[{\"constituentID\":54927,\"displayName\":\"Sherrie Levine\",\"nationality\":\"American\",\"prefix\":\"\",\"role\":\"Artist\",\"roleID\":19}],\"artistsFlattened\":[\"Sherrie Levine\"],\"classifications\":[\"Photographs\"],\"culture\":null,\"crdCollectionIds\":[19,46],\"crdId\":267221,\"creditLine\":\"Gift of the artist, 1995\",\"dated\":\"1981\",\"departmentName\":[\"Photographs\"],\"departmentSlug\":[\"photographs\"],\"dynasty\":null,\"description\":null,\"extendedStatuses\":[\"accessioned\"],\"gallery\":\"302\",\"geography\":[],\"geolocation\":[\"North and Central America\",\"United States\"],\"has3d\":false,\"hasImage\":true,\"hasNaziEraProvenance\":false,\"isHighlight\":false,\"isOnView\":true,\"isOpenAccess\":false,\"materials\":[\"Photographs\"],\"medium\":\"Gelatin silver print\",\"objectName\":\"Photograph\",\"period\":null,\"provenance\":\"Sherrie Levine\",\"reign\":null,\"sortArtist\":\"levine sherrie\",\"sortTitle\":\"after walker evans 15\",\"suggestionArtists\":[{\"value\":\"Sherrie Levine\"}],\"suggestionGeolocations\":[{\"value\":\"North and Central America\"},{\"value\":\"United States\"}],\"suggestionMaterials\":[{\"value\":\"Photographs\"}],\"tags\":[\"Burials\"],\"thumbnailAltText\":\"After Walker Evans: 15, Sherrie Levine  American, Gelatin silver print\",\"thumbnailUrl\":\"https://images.metmuseum.org/CRDImages/ph/web-additional/DP156444.jpg\",\"tmsDepartmentId\":501,\"title\":[\"After Walker Evans: 15\",\"[Grave Plot with Dish]\"],\"whenFrom\":1981,\"whenTo\":1981,\"yearsMinMax\":[1981,1981],\"yearRange\":{\"gte\":1981,\"lte\":1981}}}],[\"$\",\"$L38\",\"collectionObject-undefined\",{\"index\":1,\"enforceMaxWidth\":true,\"object\":{\"accessionNumber\":\"2020.286a, b\",\"artistPrimary\":\"William Harper\",\"artistSecondary\":[],\"artists\":[{\"constituentID\":144447,\"displayName\":\"William Harper\",\"nationality\":\"American\",\"prefix\":\"\",\"role\":\"Artist\",\"roleID\":19}],\"artistsFlattened\":[\"William Harper\"],\"classifications\":[\"Jewelry\"],\"culture\":null,\"crdCollectionIds\":[21,887],\"crdId\":848439,\"creditLine\":\"Gift of William Benjamin-Harper, in honor of Beth Carver Wees, 2020\",\"dated\":\"1999\",\"departmentName\":[\"Modern and Contemporary Art\"],\"departmentSlug\":[\"modern-and-contemporary-art\"],\"dynasty\":null,\"description\":\"William Harper is a jewelry artist renowned for his workmanship in gold and the application of cloisonné enamel techniques in his brooches and necklaces. This box and enclosed brooch is an example of his more conceptual work, forming part of a series of \\\"casks\\\" containing brooches, or \\\"tomb jewels\\\" contained within. Harper was inspired by childhood trips to European cathedrals and his encounter with their treasuries. Here, he intends for the exterior surface of the container to appear rough and provisional, even threatening and dangerous to an extent–with the readymade nature of the box and use of found materials and fragments in marked contrast to the precious materials contained within–specifically, one of his gold brooches. The materials and techniques used in the box are suffused with historical references to other examples in the Museum’s collections, including cloisonné enamel; Kongo Nkisi power figures; and 20th century examples, such as the boxes of Joseph Cornell and Lucas Samaras.\",\"extendedStatuses\":[\"accessioned\"],\"gallery\":\"302\",\"geography\":[],\"geolocation\":[\"North and Central America\",\"United States\"],\"has3d\":false,\"hasImage\":true,\"hasNaziEraProvenance\":false,\"isHighlight\":false,\"isOnView\":true,\"isOpenAccess\":false,\"materials\":[\"Shell\",\"Wood\",\"Leather\",\"Glass\",\"Plastic\",\"Metal\",\"Cord\",\"Gold\",\"Costume\",\"Jewelry\"],\"medium\":\"Wood, leather, glass, plastic, shell, specimen butterfly, mixed media metals, cord, gold\",\"objectName\":null,\"period\":null,\"provenance\":\"the artist, New York (from 1999); William Benjamin-Harper, New York (until 2020; his gift to MMA)\",\"reign\":null,\"sortArtist\":\"harper william\",\"sortTitle\":\"glass gardens cask ii tomb jewel ii\",\"suggestionArtists\":[{\"value\":\"William Harper\"}],\"suggestionGeolocations\":[{\"value\":\"North and Central America\"},{\"value\":\"United States\"}],\"suggestionMaterials\":[{\"value\":\"Shell\"},{\"value\":\"Wood\"},{\"value\":\"Leather\"},{\"value\":\"Glass\"},{\"value\":\"Plastic\"},{\"value\":\"Metal\"},{\"value\":\"Cord\"},{\"value\":\"Gold\"},{\"value\":\"Costume\"},{\"value\":\"Jewelry\"}],\"tags\":[],\"thumbnailAltText\":\"Glass Gardens Cask II; Tomb Jewel II, William Harper  American, Wood, leather, glass, plastic, shell, specimen butterfly, mixed media metals, cord, gold\",\"thumbnailUrl\":\"https://images.metmuseum.org/CRDImages/ma/web-additional/Harper.2020.jpg\",\"tmsDepartmentId\":388,\"title\":[\"Glass Gardens Cask II; Tomb Jewel II\"],\"whenFrom\":1999,\"whenTo\":1999,\"yearsMinMax\":[1999,1999],\"yearRange\":{\"gte\":1999,\"lte\":1999}}}],\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\",\"$L3f\",\"$L40\",\"$L41\",\"$L42\"]}]},{\"name\":\"In the same medium\",\"body\":\"$L43\"},{\"name\":\"From the same time and place\",\"body\":\"$L44\"}]}],false]}],\"$L45\"]}]\n"])</script><script>self.__next_f.push([1,"31:[\"$\",\"section\",null,{\"className\":\"object-page-section-module-scss-module__qlgkoq__wrapper\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"object-page-section-module-scss-module__qlgkoq__header\",\"children\":\"Research Resources\"}],[\"$\",\"div\",null,{\"className\":\"object-page-section-module-scss-module__qlgkoq__content\",\"children\":[[\"$\",\"p\",\"8fb05e5c925c\",{\"children\":[\"The Met provides unparalleled \",[\"$\",\"$L1a\",\"b6079cf1eaa8\",{\"href\":{\"pathname\":\"/hubs/research-at-the-met\"},\"className\":null,\"children\":[\"resources for research\"]}],\" and welcomes an international community of students and scholars. \",[\"$\",\"$L1a\",\"c79332752c81\",{\"className\":null,\"href\":\"https://metmuseum.github.io/\",\"target\":\"_self\",\"rel\":\"noreferrer\",\"children\":[\"The Met's Open Access API\"]}],\" is where creators and researchers can connect to the The Met collection. \",[\"$\",\"$L1a\",\"5d09a68ea440\",{\"className\":null,\"href\":\"https://www.metmuseum.org/about-the-met/policies-and-documents/open-access\",\"target\":\"_self\",\"rel\":\"noreferrer\",\"children\":[\"Open Access\"]}],\" data and public domain images are available for unrestricted commercial and noncommercial use without permission or fee.\"]}],[\"$\",\"p\",\"e0e22300cb81\",{\"children\":[\"To request images under copyright and other restrictions, please use \",[\"$\",\"$L1a\",\"41f0a9122fab\",{\"className\":null,\"href\":\"https://airtable.com/shrpUhgQjmvt7JgDL\",\"target\":\"_self\",\"rel\":\"noreferrer\",