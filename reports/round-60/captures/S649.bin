aProvenance\":false,\"isHighlight\":false,\"isOnView\":true,\"isOpenAccess\":true,\"materials\":[\"Hematite\",\"Amulets\"],\"medium\":\"Hematite\",\"objectName\":\"Amulet, falcon\",\"period\":\"Middle Kingdom\",\"provenance\":\"Excavated at Abydos in 1904 by C. T. Currelly on behalf of the Egypt Exploration Fund. Acquired by the EEF in the division of finds. Donated by the EEF to the Metropolitan Museum in 1904.\",\"reign\":null,\"sortArtist\":null,\"sortTitle\":\"amulet in the form of a falcon\",\"suggestionArtists\":[],\"suggestionGeolocations\":[{\"value\":\"Africa\"},{\"value\":\"Egypt\"},{\"value\":\"Upper Egypt\"},{\"value\":\"Abydos\"}],\"suggestionMaterials\":[{\"value\":\"Hematite\"},{\"value\":\"Amulets\"}],\"tags\":[],\"thumbnailAltText\":\"Amulet in the Form of a falcon, Hematite\",\"thumbnailUrl\":\"https://images.metmuseum.org/CRDImages/eg/web-additional/LC-04_18_27_EGDP036229.jpg\",\"tmsDepartmentId\":229,\"title\":[\"Amulet in the Form of a falcon\"],\"whenFrom\":-1850,\"whenTo\":-1775,\"yearsMinMax\":[-1850,-1775],\"yearRange\":{\"gte\":-1850,\"lte\":-1775}}}]\n"])</script><script>self.__next_f.push([1,"49:[\"$\",\"$L38\",\"collectionObject-undefined\",{\"index\":4,\"enforceMaxWidth\":true,\"object\":{\"accessionNumber\":\"25.3.169-related\",\"artistPrimary\":null,\"artistSecondary\":[],\"artists\":[],\"artistsFlattened\":[],\"classifications\":[],\"culture\":null,\"crdCollectionIds\":[10],\"crdId\":551037,\"creditLine\":\"Rogers Fund, 1925\",\"dated\":\"ca. 1070–945 B.C.\",\"departmentName\":[\"Egyptian Art\"],\"departmentSlug\":[\"egyptian-art\"],\"dynasty\":\"Dynasty 21\",\"description\":\"This group of objects was found on the throat of the Lady Djedmutesankh, threaded together in a tight bunch. There are now 7 amulets of various materials: 2 plaques, one incised with the image of a man and the other with a rearing cobra; 2 wedjat eyes; 1 wadj (papyrus) scepter; 1 heart; and 1 \\\"Isis knot\\\" (girdle tie). Two additional amulets, a heart and a papyrus stalk, both of green glass, disintegrated after they were discovered. See 25.3.169a–i for the individual amulets.For other objects found in the burial of Djedmutesankh, see 25.3.1-.3; 154a-d;.17-.18; .24; .27; and .167-.170.\",\"extendedStatuses\":[\"accessioned\"],\"gallery\":\"126\",\"geography\":[\"Egypt\",\"Upper Egypt, Thebes\",\"Deir el-Bahri\",\"Tomb MMA 60, Chamber\",\"MMA excavations, 1923–24\",\"Burial of Djedmutesankh (Ch5)\"],\"geolocation\":[\"Africa\",\"Egypt\",\"Upper Egypt\",\"Thebes\"],\"has3d\":false,\"hasImage\":true,\"hasNaziEraProvenance\":false,\"isHighlight\":false,\"isOnView\":true,\"isOpenAccess\":true,\"materials\":[\"Lapis lazuli\",\"Hematite\",\"Chalcedony\",\"Carnelian\",\"Amulets\",\"Plaques\"],\"medium\":\"Lapis lazuli, hematite, carnelian\",\"objectName\":\"Amulets, Djedmutesankh; plaque; heart (ib); wedjat; tit; uraeus plaque, wadj\",\"period\":\"Third Intermediate Period\",\"provenance\":\"Museum excavations 1923–24. Acquired by the Museum in the division of finds, 1925.\",\"reign\":null,\"sortArtist\":null,\"sortTitle\":\"group of 7 amulets\",\"suggestionArtists\":[],\"suggestionGeolocations\":[{\"value\":\"Africa\"},{\"value\":\"Egypt\"},{\"value\":\"Upper Egypt\"},{\"value\":\"Thebes\"}],\"suggestionMaterials\":[{\"value\":\"Lapis lazuli\"},{\"value\":\"Hematite\"},{\"value\":\"Chalcedony\"},{\"value\":\"Carnelian\"},{\"value\":\"Amulets\"},{\"value\":\"Plaques\"}],\"tags\":[],\"thumbnailAltText\":\"Group of 7 amulets, Lapis lazuli, hematite, carnelian\",\"thumbnailUrl\":\"https://images.metmuseum.org/CRDImages/eg/web-additional/25.3.169a-g_EGDP017236.jpg\",\"tmsDepartmentId\":229,\"title\":[\"Group of 7 amulets\"],\"whenFrom\":-1070,\"whenTo\":-945,\"yearsMinMax\":[-1070,-945],\"yearRange\":{\"gte\":-1070,\"lte\":-945}}}]\n"])</script><script>self.__next_f.push([1,"4a:[\"$\",\"$L38\",\"collectionObject-undefined\",{\"index\":5,\"enforceMaxWidth\":true,\"object\":{\"accessionNumber\":\"10.130.1796\",\"artistPrimary\":nul